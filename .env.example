# ag-relay configuration — copy these names into your host's environment
# variables (Vercel project settings, or a local .env you NEVER commit).
# Nothing in this project needs real values in source code.

# Google OAuth refresh token for YOUR OWN Google account (obtained with
# `npm run login`, stored locally in ~/.ag-relay/config.json — never commit it).
AG_REFRESH_TOKEN=

# OAuth client credentials of the official Antigravity desktop client.
# See README → "Client credentials" for where to find them in your own
# Antigravity installation. Never hardcode them into forks you publish.
AG_CLIENT_ID=
AG_CLIENT_SECRET=

# The API key clients must send to your relay. Generate a long random one,
# e.g.:  openssl rand -hex 24   →   then prefix it, e.g. sk-relay-<hex>
RELAY_API_KEY=

# Optional: the Code Assist project id. Auto-discovered when omitted.
AG_PROJECT_ID=

# Optional: password for the dashboard page (/). Strongly recommended.
DASH_PASSWORD=

# Optional dashboard branding (footer). Leave empty to hide a link.
DASH_BRAND=Relay
DASH_INSTAGRAM_URL=
DASH_INSTAGRAM_LABEL=Instagram
DASH_TELEGRAM_URL=
DASH_GITHUB_URL=
